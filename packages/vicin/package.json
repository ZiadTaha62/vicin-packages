{
  "private": "true",
  "name": "vicin",
  "version": "1.0.0",
  "description": "Vicin",
  "license": "MIT",
  "author": "Ziad ziadtaha62@gmail.com",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest --coverage --run",
    "test:types": "tsd --files tests/types/**/*.test-d.ts",
    "test": "vitest --coverage --run && tsd --files tests/types/**/*.test-d.ts",
    "prepack": "turbo run build --filter=vicin",
    "prepublishOnly": "turbo run test --filter=vicin",
    "size": "size-limit",
    "bench": "vitest bench --run"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 KB"
    }
  ],
  "dependencies": {
    "@vicin/sigil": "workspace:*",
    "@vicin/phantom": "workspace:*",
    "@vicin/superjson": "workspace:*",
    "@vicin/ddd-core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZiadTaha62/vicin-packages.git",
    "directory": "packages/vicin"
  },
  "homepage": "https://github.com/ZiadTaha62/vicin-packages/tree/main/packages/vicin"
}
